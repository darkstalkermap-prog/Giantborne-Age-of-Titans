	"nodes": [
		{
			"id": "silent",
			"text": "The throne's stones are silent. Only the wind over the Moot speaks here.",
			"choices": [
				{
					"text": "Leave.",
					"next": ""
				}
			]
		},
		{
			"id": "open",
			"text": "They come up the Giant's Stair to the Stone Throne, the oath-holders and the clans' runners, and they all say the same first thing: the rim has cracked. North of the Cairnlands the mountains have split from their roots to their crowns, and something old is breathing on the other side. Each brings word of what their people will do.",
			"choices": [
				{
					"text": "Hear Marchwarden Edda.",
					"next": "brannock_sends",
					"conditions": [
						{
							"type": "flag",
							"flag": "pledge.brannock",
							"equals": "sends"
						}
					]
				},
				{
					"text": "Hear Marchwarden Edda.",
					"next": "brannock_refuses",
					"conditions": [
						{
							"type": "flag",
							"flag": "pledge.brannock",
							"equals": "refuses"
						}
					]
				}
			]
		},
		{
			"id": "brannock_sends",
			"text": "Brannock's word, from Marchwarden Edda: the March keeps its oath. Spears and carts will come up the Ironway when you call.",
			"choices": [
				{
					"text": "Hear Wren of Hollowmere.",

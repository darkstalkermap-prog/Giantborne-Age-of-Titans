					"conditions": [
						{
							"type": "flag",
							"flag": "pledge.greywood",
							"equals": "sends"
						}
					]
				},
				{
					"text": "Hear Wren of Hollowmere.",
					"next": "greywood_refuses",
					"conditions": [
						{
							"type": "flag",
							"flag": "pledge.greywood",
							"equals": "refuses"
						}
					]
				}
			]
		},
		{
			"id": "brannock_refuses",
			"text": "Brannock's word, from Marchwarden Edda: the March swore to no one, or swore under the shadow of your fist. It will bar its gates and keep its own.",

{
	"schema_version": 1,
	"id": "quest.main",
	"type": "quest",
	"display_name": "The Valley of Broken Kings",
	"description": "The slice's quest line (plan section 4.5, spec section 14): out of Giant's Hollow, through the Old Wood and its ogre, growth at the Grove, Thornwick's choice, the bridge, the ruins, the Ogre King in Kingsfall, growth to stage 3, the tree, the Deadfall and the crown. Stages run in order and read world state, so a goal reached early completes as soon as its stage comes up; the 'entered' stages also accept the persistent states that can only come after them (a reload forgets which areas were entered). XP is accelerated quest XP (prototype pacing, decision 7); the budget is pinned by tests/unit/test_xp_budget.gd.",
	"prototype_pacing": true,
	"auto_start": true,
	"start_conditions": [],
	"abandon_when": null,
	"stages": [
		{"id": "leave_hollow", "objective": "Follow the trail north into the Old Wood",
			"complete_when": {"type": "any", "of": [
				{"type": "entered", "area": "valley.area.forest_edge"},
				{"type": "encounter_cleared", "encounter": "encounter.forest_wolves_a"},
				{"type": "killed", "targets": ["valley.forest.ogre"]}]},
			"marker": "valley.marker.forest_trail", "xp": 60, "items": [], "set_flags": {},
			"bot": {"action": "go", "target": "valley.marker.forest_trail"}},
		{"id": "wolves", "objective": "Survive the wolf pack",
			"complete_when": {"type": "any", "of": [
				{"type": "encounter_cleared", "encounter": "encounter.forest_wolves_a"},
				{"type": "killed", "targets": ["valley.forest.ogre"]}]},
			"marker": "valley.marker.wolves_a", "xp": 30, "items": [], "set_flags": {},
			"bot": {"action": "fight_encounter", "target": "encounter.forest_wolves_a"}},
		{"id": "ogre", "objective": "Defeat the ogre blocking the forest trail",
			"complete_when": {"type": "killed", "targets": ["valley.forest.ogre"]},
			"marker": "valley.marker.ogre_clearing", "xp": 110, "items": [], "set_flags": {},
			"bot": {"action": "kill", "target": "valley.forest.ogre", "encounter": "encounter.forest_ogre"}},
		{"id": "grove", "objective": "Reach the Grove Shrine and grow",
			"complete_when": {"type": "stage_at_least", "stage": 2},
			"marker": "valley.marker.grove_shrine", "xp": 30, "items": [], "set_flags": {},
			"bot": {"action": "grow", "target": "valley.shrine.grove", "stage": 2}},
		{"id": "hurl", "objective": "Hurl a boulder at the watch cairn on the ledge",
			"complete_when": {"type": "destroyed", "world_id": "valley.grove.cairn"},
			"marker": "valley.marker.cairn", "xp": 30, "items": [], "set_flags": {},
			"bot": {"action": "hurl_at", "target": "valley.grove.cairn"}},
		{"id": "to_village", "objective": "Follow the King's Road to Thornwick",
			"complete_when": {"type": "any", "of": [
				{"type": "entered", "area": "valley.area.village"},
				{"type": "flag", "flag": "dialogue.elder.met"},
				{"type": "flag", "flag": "quest.village.outcome"}]},
			"marker": "valley.marker.village_gate", "xp": 20, "items": [], "set_flags": {},
			"bot": {"action": "go", "target": "valley.marker.village_gate"}},
		{"id": "village", "objective": "Settle things with Thornwick (Elder Maren)",
			"complete_when": {"type": "flag", "flag": "quest.village.outcome"},
			"marker": "valley.marker.elder", "xp": 0, "items": [], "set_flags": {},
			"bot": {"action": "talk", "target": "valley.village.elder", "dialogue": "dialogue.elder"}},
		{"id": "bridge", "objective": "Cross the King's Bridge to the ruins",
			"complete_when": {"type": "any", "of": [
				{"type": "entered", "area": "valley.area.ruins_approach"},
				{"type": "destroyed", "world_id": "valley.ruins.practice_gate"}]},
			"marker": "valley.marker.bridge", "xp": 0, "items": [], "set_flags": {},
			"bot": {"action": "go", "target": "valley.marker.bridge"}},
		{"id": "gate", "objective": "Break the practice gate of the ruins",
			"complete_when": {"type": "destroyed", "world_id": "valley.ruins.practice_gate"},
			"marker": "valley.marker.practice_gate", "xp": 60, "items": [], "set_flags": {},
			"bot": {"action": "break", "target": "valley.ruins.practice_gate", "encounter": "encounter.ruins_gate"}},
		{"id": "courtyard", "objective": "Break the garrison in the courtyard",
			"complete_when": {"type": "any", "of": [
				{"type": "encounter_cleared", "encounter": "encounter.ruins_courtyard"},
				{"type": "entered", "area": "valley.area.causeway"},
				{"type": "flag", "flag": "world.ogre_king.defeated"}]},
			"marker": "valley.marker.ruins_courtyard", "xp": 0, "items": [], "set_flags": {},
			"bot": {"action": "fight_encounter", "target": "encounter.ruins_courtyard"}},
		{"id": "causeway", "objective": "Find the Kings' Causeway",
			"complete_when": {"type": "any", "of": [
				{"type": "entered", "area": "valley.area.causeway"},
				{"type": "flag", "flag": "world.ogre_king.defeated"}]},
			"marker": "valley.marker.causeway", "xp": 40, "items": [], "set_flags": {},
			"bot": {"action": "go", "target": "valley.marker.causeway"}},
		{"id": "boss", "objective": "Defeat the Ogre King in Kingsfall",
			"complete_when": {"type": "killed", "targets": ["valley.arena.ogre_king"]},
			"marker": "valley.marker.arena_center", "xp": 120, "items": [], "set_flags": {},
			"bot": {"action": "kill", "target": "valley.arena.ogre_king", "rest_first": "valley.shrine.kingsfall"}},
		{"id": "grow3", "objective": "Return to the Kingsfall Shrine and grow",
			"complete_when": {"type": "stage_at_least", "stage": 3},
			"marker": "valley.marker.kingsfall_shrine", "xp": 30, "items": [], "set_flags": {},
			"bot": {"action": "grow", "target": "valley.shrine.kingsfall", "stage": 3}},
		{"id": "tree", "objective": "Uproot an ancient oak",
			"complete_when": {"type": "flag", "flag": "world.tree_weapon_taken"},
			"marker": "valley.marker.kingsfall_oak", "xp": 20, "items": [], "set_flags": {},
			"bot": {"action": "interact", "target": "valley.kingsfall.oak"}},
		{"id": "deadfall", "objective": "Smash the Deadfall in the Old Wood with your tree",
			"complete_when": {"type": "destroyed", "world_id": "valley.forest.deadfall"},
			"marker": "valley.marker.deadfall", "xp": 40, "items": [], "set_flags": {},
			"bot": {"action": "break", "target": "valley.forest.deadfall", "weapon": "weapon.tree_oak"}},
		{"id": "crown", "objective": "Claim the Crown of the First King",
			"complete_when": {"type": "flag", "flag": "slice.crown_claimed"},
			"marker": "valley.marker.crown", "xp": 50, "items": [], "set_flags": {},
			"bot": {"action": "interact", "target": "valley.barrow.crown", "encounter": "encounter.barrow_wardens"}}
	],
	"on_complete_flags": {"slice.completed": true}
}

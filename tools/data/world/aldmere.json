		{"kind": "condition_forge", "id": "world.aldmere.fort_forge", "pos": [604, -226], "yaw": 90, "tier": "titan", "display_name": "Fort Aldmere's forge", "radius": 8, "faction": "aldmere", "hostile_message": "At war with Aldmere: the fort's smiths will not work for you.", "open_when": {"type": "any", "of": [{"type": "flag", "flag": "oath.crown.outcome", "equals": "parley"}, {"type": "flag", "flag": "boss.corvane.outcome", "equals": "spared"}]}, "closed_message": "The fort's smiths work only for Aldmere's friends: swear the crown's peace, or spare its warlord."},
